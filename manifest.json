{
  "manifest_version": 3,
  "name": "Облтех — перенос задач",
  "version": "0.3.3",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "description": "Перенос описания, изображений и MHTML через вашу браузерную сессию.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "pageCapture", "downloads", "offscreen"],
  "host_permissions": ["https://jira.mos.social/*", "https://rm.oblteh.ru/*", "http://jira.oblteh:8080/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Облтех — перенос задач",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {"service_worker": "background.js"}
}
